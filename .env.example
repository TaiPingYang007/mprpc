# mprpc local development environment template
# Copy to .env and adjust values for your machine if you want to load config from environment variables.

# RPC provider listen/advertise settings
RPC_BIND_IP=127.0.0.1
RPC_PORT=8000
RPC_ADVERTISE_HOST=127.0.0.1
RPC_IO_THREADS=4

# ZooKeeper service discovery
ZK_ENDPOINTS=127.0.0.1:2181
MPRPC_ZK_NAMESPACE=mprpc
ZK_CONNECT_TIMEOUT_MS=5000
ZK_SESSION_TIMEOUT_MS=30000

# RPC caller timeouts
RPC_CONNECT_TIMEOUT_MS=3000
RPC_SEND_TIMEOUT_MS=3000
RPC_RECV_TIMEOUT_MS=5000

# RpcLogger
# MPRPC_LOG_MODE supports: stdout, file
MPRPC_LOG_MODE=stdout
MPRPC_LOG_DIR=logs
MPRPC_LOG_NAME=mprpc
MPRPC_LOG_QUEUE_CAP=10000
